foreground                 = #73c936

cursor-style               = block
cursor-style-blink         = true
cursor-color               = #fc0fc0
cursor-text                = #000000
shell-integration-features = no-cursor


font-size                  = 20
font-family                = "Terminess Nerd Font Propo"
font-family-bold           = "Terminess Nerd Font Propo"
font-family-italic         = "Terminess Nerd Font Propo"
font-family-bold-italic    = "Terminess Nerd Font Propo"


background-opacity         = 1
window-theme               = dark
# window-decoration        = none
theme                      = 12-bit Rainbow
