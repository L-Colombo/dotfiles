cursor-style               = block
cursor-style-blink         = true
cursor-color               = #fc0fc0
cursor-text                = #000000
shell-integration-features = no-cursor


font-size                  = 16
font-family                = "CaskaydiaCove Nerd Font Propo"
font-family-bold           = "CaskaydiaCove Nerd Font Propo"
font-family-italic         = "CaskaydiaCove Nerd Font Propo"
font-family-bold-italic    = "CaskaydiaCove Nerd Font Propo"


background-opacity         = 0.85
window-theme               = dark
# window-decoration        = none
theme                      = Modus Vivendi
